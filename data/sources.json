    "SK hynix": "skhynix.com", "Micron": "micron.com", "Toshiba": "toshiba.semicon-storage.com", "Cypress": "infineon.com",
    "Padauk": "padauk.com.tw", "Nuvoton": "nuvoton.com", "Silicon Labs": "silabs.com", "FTDI": "ftdichip.com",
