{
  "_readme": "Настройки по умолчанию. НЕ редактируйте этот файл — свои изменения пишите в config.json (его создаёт окно «Настройки»). Там достаточно указать только изменённые параметры.",

  "modules": {
    "enhancer":   "chipfinder.modules.enhance_opencv:OpenCVEnhancer",
    "ocr":        "chipfinder.modules.ocr_tesseract:TesseractOCR",
    "identifier": "chipfinder.modules.identify_rules:RuleIdentifier",
    "local_db":   "chipfinder.modules.localdb_sqlite:SQLiteLocalDB",
    "web_search": "chipfinder.modules.web.search:MultiLevelWebSearch",
    "pdf_text":   "chipfinder.modules.pdftext_pypdf:PyPdfText",
    "comparator": "chipfinder.modules.compare_basic:BasicComparator",
    "memory":     "chipfinder.modules.memory_rules:RuleMemoryAnalyzer",
    "report":     "chipfinder.modules.report_html:HtmlReport"
  },

  "paths": {
    "db": "data/chipfinder.sqlite",
    "library_dir": "data/library",
    "quarantine_dir": "data/quarantine",
    "log_dir": "logs",
    "reports_dir": "reports",
    "scan_roots": []
  },

  "module_settings": {
    "enhancer":   {"target_height": 500, "max_upscale": 5.0, "deskew": true},
    "ocr":        {"tesseract_cmd": "", "lang": "eng", "psm_modes": [6, 11], "rotations": [0, 90, 180, 270], "min_line_conf": 30},
    "identifier": {"max_candidates": 12, "check_local_db": true},
    "local_db":   {},
    "web_search": {"max_parts": 2, "stop_after_good_hits": 3, "engines_per_query": 1, "follow_pages": 3, "max_hits": 60, "quarantine_keep_days": 7},
    "pdf_text":   {"max_pages": 40},
    "comparator": {},
    "memory":     {},
    "report":     {}
  },

  "pipeline": {
    "local_accept_score": 0.8,
    "auto_web_search": false,
    "auto_download": true,
    "auto_download_count": 3
  },

  "network": {
    "offline": false,
    "proxy": "",
    "use_system_proxy": true,
    "timeout_sec": 15,
    "min_interval_sec": 1.5,
    "max_html_mb": 3,
    "max_pdf_mb": 40,
    "allowed_domains": [],
    "allow_http": [],
    "blocked_domains": []
  }
